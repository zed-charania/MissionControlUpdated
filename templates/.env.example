# Mission Control (local-only)
# OpenClaw CLI must be on PATH.

# Security defaults
# - Bind to loopback so nothing is reachable from LAN.
# - Port is chosen at runtime; 3000 is a default only.
MISSION_CONTROL_BIND=127.0.0.1
MISSION_CONTROL_PORT=3000

# Data persistence
MISSION_CONTROL_DATA_DIR=./data

# Feature flags
FEATURE_OFFICE=false
